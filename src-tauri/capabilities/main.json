{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The only window. It may listen for state events and call hydration.sys's own commands; no filesystem, shell, dialog or network access.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-snapshot",
    "allow-log-drink",
    "allow-undo-last",
    "allow-delete-entry",
    "allow-update-settings",
    "allow-complete-onboarding",
    "allow-snooze",
    "allow-pause-today",
    "allow-resume-reminders",
    "allow-test-notification",
    "allow-set-autostart",
    "allow-confirm-tray",
    "allow-export-json",
    "allow-export-text",
    "allow-import-pick",
    "allow-import-confirm",
    "allow-import-cancel",
    "allow-reset-all",
    "allow-mark-boot-shown",
    "allow-dismiss-notice",
    "allow-hide-window",
    "allow-quit-app"
  ]
}
